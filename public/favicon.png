<svg width="32" height="32" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="favicon-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#6366f1;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Main circle background -->
  <circle cx="16" cy="16" r="14" fill="url(#favicon-gradient)" />
  
  <!-- Central hub -->
  <circle cx="16" cy="16" r="3" fill="white" />
  
  <!-- Platform nodes (simplified for favicon) -->
  <circle cx="16" cy="6" r="2" fill="#f59e0b" />
  <circle cx="26" cy="16" r="2" fill="#f59e0b" />
  <circle cx="16" cy="26" r="2" fill="#f59e0b" />
  <circle cx="6" cy="16" r="2" fill="#f59e0b" />
  
  <!-- Connection lines -->
  <line x1="16" y1="13" x2="16" y2="8" stroke="white" stroke-width="1" />
  <line x1="19" y1="16" x2="24" y2="16" stroke="white" stroke-width="1" />
  <line x1="16" y1="19" x2="16" y2="24" stroke="white" stroke-width="1" />
  <line x1="13" y1="16" x2="8" y2="16" stroke="white" stroke-width="1" />
</svg>