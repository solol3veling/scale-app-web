# Multi-stage build for React/Vite application - Production
# Stage 1: Build stage
FROM node:20-alpine AS builder

# Set working directory
WORKDIR /app

# Install build dependencies for native modules
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --production=false && \
    npm cache clean --force

# Copy source code
COPY . .

# Build with placeholder environment variables (will be replaced at runtime)
ENV VITE_API_BASE_URL=__VITE_API_BASE_URL__
ENV VITE_CLOUDINARY_CLOUD_NAME=__VITE_CLOUDINARY_CLOUD_NAME__
ENV VITE_CLOUDINARY_API_URL=__VITE_CLOUDINARY_API_URL__
ENV VITE_BACKEND_BASE_URL=__VITE_BACKEND_BASE_URL__
ENV VITE_SUPABASE_URL=__VITE_SUPABASE_URL__
ENV VITE_SUPABASE_ANON_KEY=__VITE_SUPABASE_ANON_KEY__
ENV VITE_SUPABASE_AUTH_TOKEN_KEY=__VITE_SUPABASE_AUTH_TOKEN_KEY__
ENV VITE_APP_URL=__VITE_APP_URL__
ENV VITE_S3_ENDPOINT=__VITE_S3_ENDPOINT__
ENV VITE_S3_REGION=__VITE_S3_REGION__
ENV VITE_S3_ACCESS_KEY_ID=__VITE_S3_ACCESS_KEY_ID__
ENV VITE_S3_SECRET_ACCESS_KEY=__VITE_S3_SECRET_ACCESS_KEY__
ENV VITE_S3_BUCKET_NAME=__VITE_S3_BUCKET_NAME__
ENV VITE_S3_FORCE_PATH_STYLE=__VITE_S3_FORCE_PATH_STYLE__
ENV VITE_S3_USE_SSL=__VITE_S3_USE_SSL__
ENV VITE_S3_PORT=__VITE_S3_PORT__

# Build the application
RUN npm run build

# Stage 2: Production stage with Node.js server
FROM node:20-alpine AS production

# Install security updates
RUN apk upgrade --no-cache

# Set working directory
WORKDIR /app

# Install serve package globally
RUN npm install -g serve

# Copy built assets from builder stage
COPY --from=builder /app/dist ./dist

# Copy runtime environment injection script
COPY deploy/inject-env.sh ./inject-env.sh
RUN chmod +x ./inject-env.sh

# Create non-root user for security
RUN addgroup -g 1001 -S appuser && \
    adduser -S appuser -u 1001 -G appuser

# Set proper permissions
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 5173

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:5173/ || exit 1

# Start with runtime environment injection
CMD ["./inject-env.sh"]