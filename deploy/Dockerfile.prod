# Multi-stage build for React/Vite application - Production
# Stage 1: Build stage
FROM node:20-alpine AS builder

# Set working directory
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install && npm cache clean --force

# Copy source code
COPY . .

# Build arguments for environment variables
# Note: These are client-side environment variables that get embedded in the built assets
# They are not secrets in the traditional sense as they are exposed to the browser
ARG VITE_API_BASE_URL
ARG VITE_CLOUDINARY_CLOUD_NAME
ARG VITE_CLOUDINARY_API_URL
ARG VITE_BACKEND_BASE_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_SUPABASE_AUTH_TOKEN_KEY
ARG VITE_APP_URL
ARG VITE_S3_ENDPOINT
ARG VITE_S3_REGION
ARG VITE_S3_ACCESS_KEY_ID
ARG VITE_S3_SECRET_ACCESS_KEY
ARG VITE_S3_BUCKET_NAME
ARG VITE_S3_FORCE_PATH_STYLE
ARG VITE_S3_USE_SSL
ARG VITE_S3_PORT

# Set environment variables for build
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_CLOUDINARY_CLOUD_NAME=$VITE_CLOUDINARY_CLOUD_NAME
ENV VITE_CLOUDINARY_API_URL=$VITE_CLOUDINARY_API_URL
ENV VITE_BACKEND_BASE_URL=$VITE_BACKEND_BASE_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_AUTH_TOKEN_KEY=$VITE_SUPABASE_AUTH_TOKEN_KEY
ENV VITE_APP_URL=$VITE_APP_URL
ENV VITE_S3_ENDPOINT=$VITE_S3_ENDPOINT
ENV VITE_S3_REGION=$VITE_S3_REGION
ENV VITE_S3_ACCESS_KEY_ID=$VITE_S3_ACCESS_KEY_ID
ENV VITE_S3_SECRET_ACCESS_KEY=$VITE_S3_SECRET_ACCESS_KEY
ENV VITE_S3_BUCKET_NAME=$VITE_S3_BUCKET_NAME
ENV VITE_S3_FORCE_PATH_STYLE=$VITE_S3_FORCE_PATH_STYLE
ENV VITE_S3_USE_SSL=$VITE_S3_USE_SSL
ENV VITE_S3_PORT=$VITE_S3_PORT

# Build the application
RUN npm run build

# Stage 2: Production stage with nginx
FROM nginx:alpine AS production

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Health check - use curl which is available in nginx:alpine
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
